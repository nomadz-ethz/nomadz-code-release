WorldInfo {
  info [
    "Simulation of the Robocup Standard Platform League"
  ]
  title "Robocup"
  basicTimeStep 12
  defaultDamping Damping {
    linear 0.3
    angular 0.75
  }
  contactProperties [
    ContactProperties {
      material1 "NAO foot material"
      coulombFriction [
        1
      ]
      bounce 0.3
      bounceVelocity 0.003
      bumpSound ""
      rollSound ""
      slideSound ""
      softERP 0.2
      softCFM 0.005
    }
  ]
  ERP 0.5
  CFM 0.001
}
Viewpoint {
  orientation -0.4 0.4 0.8 1.77
  position 0 -10 13
  followType "Pan and Tilt Shot"
}
TexturedBackground {
  texture "stadium"
}
TexturedBackgroundLight {
  texture "stadium"
}
SPL_Field {
}
DEF Ball SPL_Ball {
}
DEF Blue1 NaoV6 {
  translation -3.6 -3.1 0.334
  rotation 0 0 1 1.57
  name "Blue1"
  controllerArgs [
    "--listen=0.0.0.0:10000"
    "--tcp"
  ]
  jersey NaoJersey {
    jerseyTexture [
      "../resource/textures/nao_jersey_dark_1.png"
    ]
    jerseyColor 0 0.75 1
  }
}
DEF Supervisor Robot{
  name "Supervisor"
  supervisor TRUE
  controller "<extern>"
}
