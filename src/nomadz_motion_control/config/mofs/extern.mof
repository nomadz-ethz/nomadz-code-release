motion_id = extern

"This motion is entry point for SpecialAction from other motion modules

label start

"All mofs must be enumerated here

transition playDead playDead start
transition goUp goUp start
transition sitDown sitDown start
transition stand stand start
transition standHigh standHigh start
transition fallProtectionBack fallProtectionBack start
transition fallProtectionFront fallProtectionFront start
transition fallProtectionSide fallProtectionSide start
transition getUpBackNao22 getUpBackNao22 start
transition getUpFrontNao22 getUpFrontNao22 start
transition sitDownKeeper sitDownKeeper start

"This line must be the last one
transition extern extern start
