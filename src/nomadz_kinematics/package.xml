<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nomadz_kinematics</name>
  <version>0.0.1</version>
  <description>Forward and inverse kinematics for the NAO robot</description>
  <maintainer email="nomadz@list.ee.ethz.ch">Team NomadZ</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_eigen</depend>
  <depend>nomadz_definitions</depend>
  <depend>nomadz_core</depend>
  <depend>nao_lola_sensor_msgs</depend>
  <depend>nomadz_proprioception_msgs</depend>
  <depend>nao_lola_command_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
